<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="563.0" prefWidth="390.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.remotecommandexecutionsystem.controller.ClientController">
   <children>
      <TextField fx:id="txtMessage" layoutX="27.0" layoutY="466.0" prefHeight="35.0" prefWidth="222.0" />
      <ListView fx:id="messageView" layoutX="28.0" layoutY="91.0" prefHeight="362.0" prefWidth="330.0" />
      <Label layoutX="144.0" layoutY="31.0" text="Client" textFill="#1ec3dc">
         <font>
            <Font name="Arial Bold" size="35.0" />
         </font>
      </Label>
      <Button fx:id="btnSend" layoutX="290.0" layoutY="466.0" mnemonicParsing="false" onAction="#btnSendOnAction" prefHeight="35.0" prefWidth="70.0" text="send">
         <font>
            <Font name="Arial Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="btnImage" layoutX="255.0" layoutY="465.0" mnemonicParsing="false" onAction="#btnImageOnAction" prefHeight="35.0" prefWidth="30.0" text="+">
         <font>
            <Font name="Arial Bold" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
